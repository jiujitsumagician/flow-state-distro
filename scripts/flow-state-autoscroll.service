[Unit]
Description=Flow State autoscroll daemon (middle-click drag = scroll, system-wide)
Documentation=https://github.com/jiujitsumagician/flow-state-distro
After=systemd-modules-load.service systemd-udevd.service dev-uinput.device
Requires=systemd-udevd.service

[Service]
Type=simple
# uinput is loaded at boot via /etc/modules-load.d/flow-state-autoscroll.conf
# (and modprobe'd once by install-autoscroll.sh). There is deliberately no
# ExecStartPre=modprobe here: loading a module needs CAP_SYS_MODULE and the
# @module syscalls, both of which the hardening below removes.
ExecStart=/usr/bin/python3 /opt/flow-state/autoscrolld.py
Restart=on-failure
RestartSec=2
User=root
Nice=-5
# Hardening. This daemon needs raw input access so many isolators must stay
# off, but we can still block a lot.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
# Extra confinement (defense in depth against a bug in python-evdev / HID
# parsing driven by a hostile USB device). The daemon only talks to
# /dev/input/event* and /dev/uinput: no network, no namespaces, no clock.
# NOTE: ProtectClock= is intentionally NOT set. It adds an implicit DeviceAllow
# for /dev/rtc, which flips the device policy to an allow-list and would block
# /dev/input (the same failure the DevicePolicy comment below describes).
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
ProtectHostname=true
ProtectProc=invisible
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# CAP_SYS_NICE is kept for Nice=-5 above; everything else is dropped. Device
# access works through root ownership of /dev/input/event* and /dev/uinput.
CapabilityBoundingSet=CAP_SYS_NICE
# DevicePolicy=closed with DeviceAllow=char-input in v1 blocked /dev/input
# reads even for root (the tag/systemd version match on Noble did not admit
# them). Leave device access as the systemd default; the daemon only reads
# /dev/input/event* and writes /dev/uinput, and the rest of the isolators
# (ProtectSystem/ProtectHome/PrivateTmp/etc.) still apply.
# Watchdog: if the main loop hangs, systemd restarts us. The current daemon
# does not call sd_notify, so this fires purely on process livelock (SIGKILL
# after WatchdogSec of no restart). Uncomment once sd_notify calls are wired
# from the loop:
# WatchdogSec=30s

[Install]
WantedBy=multi-user.target
